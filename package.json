{
  "name": "cerebral-monorepo",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "build": "repo-cooker --build",
    "build:website": "cd packages/cerebral-website && npm run build",
    "checkdeps": "repo-cooker --check-dependencies",
    "commit": "git-cz",
    "commit-msg": "cz-customizable-ghooks",
    "coverage": "repo-cooker coverage",
    "fixdeps": "repo-cooker --fix-dependencies",
    "format": "eslint --fix . && prettier --write --with-node-modules --list-different .",
    "install": "npm run link && npm run build",
    "link": "repo-cooker --link",
    "lint": "eslint . && prettier --check --with-node-modules .",
    "lint-staged": "lint-staged",
    "postcoverage": "node scripts/coverage-combine.js",
    "prelint": "npm run typecheck",
    "prepare": "husky",
    "pretest": "npm run checkdeps",
    "release": "repo-cooker --release",
    "test": "repo-cooker test --no-parallel && npm run lint",
    "typecheck": "repo-cooker typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerebral/cerebral.git"
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "es6-error": "4.1.1",
    "eventemitter3": "5.0.4",
    "prop-types": "15.8.1",
    "universal-websocket-client": "1.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --with-node-modules"
    ],
    "*.{md,css,json}": "prettier --write --with-node-modules"
  },
  "config": {
    "cz-customizable": {
      "config": ".cz-config.js"
    }
  },
  "devDependencies": {
    "@angular/animations": "19.2.20",
    "@angular/compiler-cli": "19.2.20",
    "@angular/core": "19.2.20",
    "@angular/platform-browser": "19.2.20",
    "@angular/platform-browser-dynamic": "19.2.20",
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@cerebral/babel-plugin": "^1.1.0",
    "@eslint/js": "^8.57.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.5.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^21.0.0",
    "assert": "^2.1.0",
    "babel-jest": "^30.3.0",
    "babel-plugin-inferno": "^6.8.5",
    "babel-plugin-transform-define": "^2.1.4",
    "babel-preset-preact": "^2.0.0",
    "babel-watch": "7.8.1",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "cz-customizable": "^7.5.1",
    "cz-customizable-ghooks": "^2.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "5.2.1",
    "fs-extra": "11.3.4",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "inferno": "^9.0.11",
    "inferno-create-element": "^9.0.11",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.1",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "marksy": "8.0.0",
    "mocha": "^11.7.5",
    "mock-socket": "^9.3.1",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "preact": "^10.29.0",
    "prettier": "^3.8.1",
    "prismjs": "1.30.0",
    "raf": "^3.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "repo-cooker": "^9.0.1",
    "string-template": "1.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.1",
    "vue": "^3.5.30",
    "zone.js": "^0.15.1"
  }
}
