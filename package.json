{
  "name": "cerebral-monorepo",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "build": "repo-cooker --build",
    "build:website": "cd packages/cerebral-website && npm run build",
    "checkdeps": "repo-cooker --check-dependencies",
    "commit": "git-cz",
    "commit-msg": "cz-customizable-ghooks",
    "coverage": "repo-cooker coverage",
    "fixdeps": "repo-cooker --fix-dependencies",
    "format": "eslint --fix . && prettier --write --with-node-modules .",
    "install": "npm run link && npm run build",
    "link": "repo-cooker --link",
    "lint": "eslint . && prettier --check --with-node-modules .",
    "lint-staged": "lint-staged",
    "postcoverage": "node scripts/coverage-combine.js",
    "prelint": "npm run typecheck",
    "prepare": "husky",
    "pretest": "npm run checkdeps",
    "release": "repo-cooker --release",
    "test": "repo-cooker test --no-parallel && npm run lint",
    "typecheck": "repo-cooker typecheck",
    "preinstall": "bash script.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerebral/cerebral.git"
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "es6-error": "4.1.1",
    "eventemitter3": "5.0.1",
    "prop-types": "15.8.1",
    "universal-websocket-client": "1.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --with-node-modules"
    ],
    "*.{md,css,json}": "prettier --write --with-node-modules"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.js"
    }
  },
  "devDependencies": {
    "@angular/animations": "^19.2.3",
    "@angular/compiler-cli": "^19.2.3",
    "@angular/core": "^19.2.3",
    "@angular/platform-browser": "^19.2.3",
    "@angular/platform-browser-dynamic": "^19.2.3",
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/node": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@babel/register": "^7.25.9",
    "@eslint/js": "^8.57.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/vue": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.13",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/sinon": "^17.0.4",
    "assert": "^2.1.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-cerebral": "next",
    "babel-plugin-inferno": "^6.8.3",
    "babel-preset-preact": "^2.0.0",
    "babel-watch": "7.8.1",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "cz-customizable": "^7.4.0",
    "cz-customizable-ghooks": "^2.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "express": "4.21.2",
    "fs-extra": "11.3.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "inferno": "^9.0.3",
    "inferno-create-element": "^9.0.3",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.5.3",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "marksy": "8.0.0",
    "mocha": "^11.1.0",
    "mock-socket": "^9.3.1",
    "npm-run-all": "^4.1.5",
    "nyc": "^17.1.0",
    "preact": "^10.26.4",
    "prettier": "^3.5.3",
    "prismjs": "1.30.0",
    "raf": "^3.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "repo-cooker": "^8.0.23",
    "string-template": "1.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vue": "^3.5.13",
    "zone.js": "^0.15.0"
  }
}
