{
  "name": "cerebral-monorepo",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "build": "repo-cooker --build",
    "checkdeps": "repo-cooker --check-dependencies",
    "commit": "git-cz",
    "commit-msg": "cz-customizable-ghooks",
    "coverage": "node ./scripts/run.js coverage",
    "deploy": "cd packages/website/publisher && npm run ci",
    "fixdeps": "repo-cooker --fix-dependencies",
    "format": "npm run lint -- --fix && prettier --write --with-node-modules \"**/*.md\" \"**/*.css\" \"**/*.json\"",
    "install": "npm run link && npm run build",
    "link": "repo-cooker --link",
    "lint": "eslint \"**/*.js\" \"**/*.ts\"",
    "lint-staged": "lint-staged",
    "postcoverage": "istanbul-combine -d coverage -p summary -r lcov -r html packages/**/coverage/*.json",
    "prepare": "husky install",
    "pretest": "npm run checkdeps",
    "release": "repo-cooker --release",
    "test": "repo-cooker test --no-parallel && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerebral/cerebral.git"
  },
  "dependencies": {
    "bulma": "0.2.3",
    "chalk": "1.1.3",
    "chokidar": "1.6.1",
    "es6-error": "4.0.2",
    "eventemitter3": "2.0.2",
    "faye-websocket": "0.11.1",
    "local-storage": "^2.0.0",
    "md5": "^2.2.1",
    "page": "1.8.6",
    "prism": "4.1.2",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "universal-websocket-client": "1.0.3",
    "uuid": "11.0.5"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --fix",
    "*.{md,css,json}": "prettier --write --with-node-modules"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.js"
    }
  },
  "devDependencies": {
    "@angular/common": "6.0.3",
    "@angular/compiler": "6.0.3",
    "@angular/core": "6.0.3",
    "@angular/platform-browser": "6.0.3",
    "@angular/platform-browser-dynamic": "6.0.3",
    "@babel/cli": "7.23.4",
    "@babel/core": "7.23.9",
    "@babel/node": "7.23.9",
    "@babel/preset-env": "7.23.9",
    "@babel/preset-react": "7.23.3",
    "@babel/preset-typescript": "7.23.3",
    "@babel/register": "7.23.7",
    "@types/mocha": "5.1.0",
    "@types/node": "^20.8.3",
    "@types/page": "1.5.32",
    "@types/prop-types": "15.5.2",
    "@types/react": "16.3.11",
    "@types/react-dom": "16.0.5",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "assert": "1.4.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-inferno": "^4.0.0",
    "babel-preset-preact": "2.0.0",
    "babel-watch": "7.8.1",
    "commitizen": "^4.3.1",
    "concurrently": "3.4.0",
    "core-js": "2.5.0",
    "cross-env": "^5.0.0",
    "cz-customizable": "^7.4.0",
    "cz-customizable-ghooks": "^2.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-jsx": "^11.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.4",
    "execa": "^0.6.3",
    "express": "4.15.4",
    "fs-extra": "2.0.0",
    "gh-pages": "1.0.0",
    "husky": "^8.0.3",
    "inferno": "^4.0.3",
    "inferno-create-element": "^4.0.3",
    "inferno-shared": "^4.0.4",
    "istanbul-combine": "^0.3.0",
    "jest": "22.4.3",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "marksy": "4.0.0",
    "mocha": "^4.1.0",
    "mock-socket": "6.0.4",
    "node-sass": "9.0.0",
    "npm-run-all": "4.0.2",
    "nyc": "^10.3.2",
    "parcel-bundler": "1.12.3",
    "parcel-plugin-typescript": "^1.0.0",
    "preact": "8.1.0",
    "prettier": "3.5.1",
    "prismjs": "1.6.0",
    "prop-types": "15.6.1",
    "raf": "^3.3.0",
    "react-scripts": "1.1.1",
    "react-scripts-ts": "2.14.0",
    "react-test-renderer": "^16.2.0",
    "repo-cooker": "^8.0.22",
    "shx": "0.2.2",
    "string-template": "1.0.0",
    "symlink-dir": "^6.0.3",
    "ts-jest": "^22.4.3",
    "ts-node": "6.0.5",
    "typescript": "4.9.5",
    "vue": "2.3.3",
    "xhr-mock": "2.1.0",
    "yargs": "6.6.0",
    "zone.js": "0.8.26"
  }
}
