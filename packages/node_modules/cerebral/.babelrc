{
  "env": {
    "test": {
      "presets": [["@babel/preset-env"]],
      "plugins": ["babel-plugin-cerebral"],
      "ignore": []
    },
    "cjs": {
      "presets": [["@babel/preset-env"]],
      "ignore": ["**/*.test.js"]
    },
    "es": {
      "presets": [["@babel/preset-env", { "modules": false }]],
      "ignore": ["**/*.test.js"]
    }
  }
}
