{
  "name": "@cerebral/babel-plugin",
  "version": "1.1.0",
  "description": "This plugin transforms the typed proxies into template literal tags.",
  "main": "lib/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "npm test -- --watch",
    "setup": "npm install @types/jest --no-save",
    "build": "cross-env BABEL_ENV=production babel -d lib ./*.js",
    "coverage": "npm test -- --coverage",
    "prepublish": "npm run build"
  },
  "author": "Fabrice Weinberg <Fabrice@weinberg.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerebral/cerebral.git"
  },
  "bugs": {
    "url": "https://github.com/cerebral/cerebral/issues"
  },
  "homepage": "https://cerebraljs.com/",
  "files": [
    "lib"
  ],
  "jest": {
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "transformIgnorePatterns": [],
    "testPathIgnorePatterns": [],
    "coveragePathIgnorePatterns": [],
    "coverageReporters": [
      "json",
      "text",
      "lcov",
      "html"
    ],
    "haste" : { 
      "retainAllFiles": true 
    } 
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  }
}